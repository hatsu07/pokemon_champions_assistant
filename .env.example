# Runtime API is disabled unless this explicit opt-in is set to 1.
# Do not place an OpenAI API key in source control, logs, screenshots, or tests.
CHAMPIONS_ASSIST_DB_PATH=%LOCALAPPDATA%\\PokemonChampionsAssistant\\database\\battle.sqlite3
# The Codex/IDE model setting is unrelated to this runtime API model.
CHAMPIONS_ASSIST_ENABLE_OPENAI_API=0
CHAMPIONS_ASSIST_OPENAI_API_KEY=
CHAMPIONS_ASSIST_OPENAI_MODEL=gpt-4.1-mini
CHAMPIONS_ASSIST_API_TIMEOUT_SECONDS=8
CHAMPIONS_ASSIST_API_SAFETY_MARGIN_MS=1500
CHAMPIONS_ASSIST_API_MAX_REQUESTS_PER_MATCH=40
CHAMPIONS_ASSIST_API_MAX_REQUESTS_PER_DAY=200
# A positive cap and a per-request estimate are both required for real transport.
CHAMPIONS_ASSIST_API_SPEND_CAP_USD=0
CHAMPIONS_ASSIST_API_ESTIMATED_REQUEST_USD=0
